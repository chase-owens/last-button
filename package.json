{
  "name": "last-button",
  "private": true,
  "workspaces": [
    "client-user",
    "domain",
    "infra",
    "lambdas",
    "mcp"
  ],
  "scripts": {
    "dev": "nx dev client-user",
    "build": "nx run-many -t build",
    "check": "nx run-many -t check",
    "clean": "nx reset && find . -name dist -type d -prune -exec rm -rf {} +",
    "lint": "nx run-many -t lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nx run-many -t test",
    "graph": "nx graph",
    "mcp:dev": "npm --workspace mcp run dev"
  },
  "devDependencies": {
    "@types/node": "^22",
    "globals": "^17.8.0",
    "nx": "23.1.0"
  },
  "allowScripts": {
    "nx@23.1.0": true
  }
}
